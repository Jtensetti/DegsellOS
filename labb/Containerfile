# ForskarOS-labbet: en låst analysmiljö för reproducerbar forskning.
#
# Bygger på Rocker-projektets tidyverse-avbildning (R, tidyverse, RStudio Server,
# Pandoc), standard för reproducerbar R, och lägger till Python med uv.
# Samma avbildning körs likadant på ForskarOS, en Mac, Windows och en server.
#
# Avbildningens digest (forskaros-labb version) är analysmiljöns version.
# Skriv den i experimentanteckningen, så kan en granskare köra om analysen.
ARG R_IMAGE=docker.io/rocker/tidyverse:4.6.2
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.13.8

FROM ${UV_IMAGE} AS uv

FROM ${R_IMAGE}
LABEL org.opencontainers.image.title="ForskarOS-labbet" \
      org.opencontainers.image.description="Reproducerbar analysmiljö: R, tidyverse, RStudio Server, Python, JupyterLab" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.source="https://github.com/Jtensetti/researchOS"

# R-paket som ofta behövs i beteende- och samhällsvetenskap.
RUN install2.r --error --skipinstalled renv psych lme4 effectsize janitor here \
 && rm -rf /tmp/downloaded_packages

# Python i en egen miljö, med låsta versioner sparade i avbildningen.
COPY --from=uv /uv /usr/local/bin/uv
COPY labb/requirements.txt /opt/forskaros/requirements.txt
ENV UV_PYTHON_INSTALL_DIR=/opt/python
RUN uv venv /opt/forskaros-python --python 3.13 \
 && uv pip install --python /opt/forskaros-python/bin/python -r /opt/forskaros/requirements.txt \
 && uv pip freeze --python /opt/forskaros-python/bin/python > /opt/forskaros/python-las.txt \
 && R -q -e 'writeLines(capture.output(sessionInfo()), "/opt/forskaros/r-session.txt")'
ENV PATH=/opt/forskaros-python/bin:$PATH

WORKDIR /arbete
CMD ["bash"]
