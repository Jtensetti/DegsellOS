#!/usr/bin/env bash
# Installerar grundprofilen som systemprogram en gång, vid första start med nätverk.
set -euo pipefail
STAMP=/var/lib/forskaros/grund.klar
PROFIL=/usr/share/forskaros/profiler/01-grund.profil
[[ -e "$STAMP" ]] && exit 0
flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
ids=$(grep -E '^\s*flatpak\s' "$PROFIL" | awk '{print $2}')
# shellcheck disable=SC2086
flatpak install --system -y --noninteractive flathub $ids
mkdir -p "$(dirname "$STAMP")"
date -Iseconds > "$STAMP"
