#!/usr/bin/env bash
# Monterar en mapp som värden (t.ex. UTM på en Mac) delar med maskinen.
# UTM:s Apple Virtualization-läge delar via virtiofs, QEMU-läget via 9p.
# Finns ingen delad mapp avslutas skriptet utan fel.
set -uo pipefail
MNT=/var/mnt/delad
TAG="${1:-share}"
mkdir -p "$MNT"
mountpoint -q "$MNT" && exit 0
if mount -t virtiofs "$TAG" "$MNT" 2>/dev/null; then
  echo "forskaros: delad mapp monterad via virtiofs på $MNT"
elif mount -t 9p -o trans=virtio,version=9p2000.L,msize=262144 "$TAG" "$MNT" 2>/dev/null; then
  echo "forskaros: delad mapp monterad via 9p på $MNT"
else
  echo "forskaros: ingen delad mapp hittades (taggen '$TAG')"
fi
exit 0
