[Unit]
Description=DegsellOS: installera forskarens grundverktyg (en gång)
Wants=network-online.target
After=network-online.target
ConditionPathExists=!/var/lib/degsellos/grund.klar

[Service]
Type=oneshot
ExecStart=/usr/libexec/degsellos-grund
Restart=on-failure
RestartSec=120
Nice=10

[Install]
WantedBy=multi-user.target
