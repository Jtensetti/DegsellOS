[Unit]
Description=ForskarOS: kräv lösenordsbyte för det förinställda kontot (en gång)
DefaultDependencies=no
After=local-fs.target systemd-sysusers.service
Before=systemd-user-sessions.service display-manager.service
ConditionPathExists=!/var/lib/forskaros/forskare-losenord.klar

[Service]
Type=oneshot
ExecStart=/usr/libexec/forskaros-forskare

[Install]
WantedBy=multi-user.target
