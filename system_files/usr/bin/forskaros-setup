#!/usr/bin/env bash
# ForskarOS – forskarens verktygslåda.
#
# Installerar verktyg i profiler (se /usr/share/forskaros/profiler).
# Öppna verktyg är standard. Proprietärt och moln-AI kräver ett aktivt val.
#
#   forskaros-setup                       interaktivt val av profiler
#   forskaros-setup --lista               visa profilerna
#   forskaros-setup --profil skriva,ai    installera valda profiler
#   forskaros-setup --ja                  kör valda profiler; licens och moln bekräftas separat
#   forskaros-setup --godkänt             licens och moln är redan bekräftade (i appen ForskarOS)
#   forskaros-setup --torrkörning         visa vad som skulle göras
set -euo pipefail

PROFILDIR="${FORSKAROS_PROFILDIR:-/usr/share/forskaros/profiler}"
STARTDIR="${FORSKAROS_STARTDIR:-/usr/share/forskaros/startare}"
DRY=0
YES=0
LIST=0
WANT=""
SYSTEM=0
AGREED=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --lista) LIST=1 ;;
    --profil) WANT="$2"; shift ;;
    --ja) YES=1 ;;
    --godkänt) AGREED=1 ;;
    --torrkörning) DRY=1 ;;
    --system) SYSTEM=1 ;;
    -h|--hjälp) sed -n '2,13p' "$0"; exit 0 ;;
    *) echo "Okänt argument: $1" >&2; exit 2 ;;
  esac
  shift
done

run() {
  if [[ $DRY -eq 1 ]]; then echo "+ $*"; else "$@"; fi
}

meta() { sed -n "s/^# $2: //p" "$1" | head -1; }
slug() { basename "$1" .profil | sed 's/^[0-9]*-//'; }
items() { grep -vE '^\s*(#|$)' "$1"; }

ask() {
  local reply
  if ! read -r -p "$1 [j/N] " reply; then return 1; fi
  [[ "$reply" =~ ^[jJyY]$ ]]
}

PROFILES=("$PROFILDIR"/*.profil)
[[ -e "${PROFILES[0]}" ]] || { echo "Hittar inga profiler i $PROFILDIR" >&2; exit 1; }

show_profiles() {
  local i=1
  for p in "${PROFILES[@]}"; do
    printf '%2d. %-38s (%s)\n' "$i" "$(meta "$p" namn)" "$(slug "$p")"
    printf '    %s\n' "$(meta "$p" beskrivning)"
    items "$p" | while read -r _ _ desc; do printf '      · %s\n' "$desc"; done
    i=$((i + 1))
  done
}

if [[ $LIST -eq 1 ]]; then show_profiles; exit 0; fi

# Välj profiler.
SELECTED=()
if [[ -n "$WANT" ]]; then
  IFS=',' read -r -a wanted <<< "$WANT"
  for w in "${wanted[@]}"; do
    match=""
    for p in "${PROFILES[@]}"; do [[ "$(slug "$p")" == "$w" ]] && match="$p"; done
    [[ -n "$match" ]] || { echo "Okänd profil: $w" >&2; exit 2; }
    SELECTED+=("$match")
  done
else
  echo "ForskarOS – forskarens verktygslåda"
  echo "ForskarOS Core kräver Obsidian (profil 2). Molntjänster installeras bara om du väljer dem."
  echo
  show_profiles
  echo
  read -r -p "Vilka profiler? (t.ex. 2 3 5, 'alla' = alla öppna profiler, Enter = avbryt) " reply
  [[ -n "$reply" ]] || exit 0
  if [[ "$reply" == "alla" ]]; then
    for p in "${PROFILES[@]}"; do [[ -n "$(meta "$p" aktivt-val)" ]] || SELECTED+=("$p"); done
  else
    for n in $reply; do
      [[ "$n" =~ ^[0-9]+$ && $n -ge 1 && $n -le ${#PROFILES[@]} ]] || { echo "Ogiltigt val: $n" >&2; exit 2; }
      SELECTED+=("${PROFILES[$((n - 1))]}")
    done
  fi
fi

FLATPAK_SCOPE=--user
[[ $SYSTEM -eq 1 ]] && FLATPAK_SCOPE=--system

ensure_flathub() {
  run flatpak remote-add "$FLATPAK_SCOPE" --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
}

ensure_uv() {
  command -v uv >/dev/null 2>&1 && return 0
  if command -v brew >/dev/null 2>&1 || [[ $DRY -eq 1 ]]; then run brew install uv; return 0; fi
  echo "uv saknas och Homebrew finns inte. Hoppar över Python-verktyget." >&2
  return 1
}

web_launcher() {
  local name="$1" url="$2" desc="$3"
  local dir="$HOME/.local/share/applications"
  local file="$dir/forskaros-webb-$name.desktop"
  if [[ $DRY -eq 1 ]]; then echo "+ skapa genväg $file → $url"; return; fi
  mkdir -p "$dir"
  cat > "$file" <<DESKTOP
[Desktop Entry]
Type=Application
Name=${desc%% –*} (moln)
Comment=${desc}
Exec=xdg-open ${url}
Icon=web-browser
Categories=Education;Science;
DESKTOP
}

for p in "${SELECTED[@]}"; do
  echo
  echo "== $(meta "$p" namn) =="
  case "$(meta "$p" aktivt-val)" in
    licens)
      echo "$(meta "$p" beskrivning)"
      if [[ $DRY -eq 0 && $AGREED -eq 0 ]] && ! ask "Installera? Du godkänner programmets licensvillkor."; then echo "Hoppar över."; continue; fi ;;
    moln)
      echo "$(meta "$p" beskrivning)"
      echo "Lägg inte in personuppgifter eller sekretessbelagt material."
      confirm="jag väljer"
      [[ $DRY -eq 1 || $AGREED -eq 1 ]] || read -r -p "Skriv 'jag väljer' för att fortsätta: " confirm || confirm=""
      [[ "$confirm" == "jag väljer" ]] || { echo "Hoppar över."; continue; } ;;
  esac
  while read -r kind id desc; do
    echo "· $desc"
    case "$kind" in
      flatpak) ensure_flathub; run flatpak install "$FLATPAK_SCOPE" -y --noninteractive flathub "$id" ;;
      brew)
        if [[ "$id" == pandoc ]] && command -v pandoc >/dev/null; then echo '  Pandoc finns redan.'; continue; fi
        if command -v brew >/dev/null 2>&1 || [[ $DRY -eq 1 ]]; then run brew install "$id"
        else echo "  Homebrew saknas, hoppar över $id."; fi ;;
      uv)
        if ensure_uv; then
          # Taguettes OpenTelemetry-version importerar pkg_resources vid start.
          if [[ "$id" == taguette ]]; then run uv tool install --with 'setuptools<81' "$id"
          else run uv tool install "$id"; fi
        fi
        tmpl="$STARTDIR/forskaros-$id.desktop"
        if [[ -f "$tmpl" ]]; then
          if [[ $DRY -eq 1 ]]; then echo "+ skapa startare forskaros-$id.desktop"
          else mkdir -p "$HOME/.local/share/applications"
               sed "s#@HOME@#$HOME#g" "$tmpl" > "$HOME/.local/share/applications/forskaros-$id.desktop"; fi
        fi ;;
      webb) web_launcher "${id%%|*}" "${id#*|}" "$desc" ;;
      *) echo "  Okänd typ: $kind" >&2 ;;
    esac
  done < <(items "$p")
done

echo
if [[ $DRY -eq 0 ]] && command -v forskaros-init >/dev/null 2>&1; then FORSKAROS_INGEN_VALKOMST=1 forskaros-init; fi
echo "Klart. Forskningsportalen och verktygen per fas finns i vaulten: 00 START/Verktygslåda."
if [[ -z "$WANT" && $DRY -eq 0 ]]; then read -r -p "Tryck Enter för att stänga." _; fi
