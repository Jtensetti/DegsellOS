#!/usr/bin/env bash
# Körs vid inloggning (GNOME autostart).
#  1. Skapar ~/DegsellOS från seed-vaulten om den inte finns.
#  2. Uppdaterar DegsellOS Core-tillägget i en befintlig vault när OS:et har
#     uppdaterats. Forskarens egna anteckningar rörs aldrig.
#  3. Ger Flatpak-programmen DegsellOS typsnitt, en gång.
#  4. Låter Obsidian öppna forskningsmappen direkt, om Obsidian inte redan har valv.
#  5. Flyttar forskningsmapp, inställningar och tillägg från namnet ForskarOS.
set -euo pipefail

SEED=/usr/share/degsellos/vault
TARGET="${DEGSELLOS_VAULT:-$HOME/DegsellOS}"
PLUGIN_REL=.obsidian/plugins/degsellos-core

# DegsellOS hette tidigare ForskarOS. Forskningsmappen, appens inställningar och
# Core-tillägget flyttas till de nya namnen en gång. Inget skrivs över.
OLD_VAULT="${DEGSELLOS_GAMMAL_VAULT:-$HOME/ForskarOS}"
NEW_VAULT_DEFAULT="$HOME/DegsellOS"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
if [[ -z "${DEGSELLOS_VAULT:-}" && -d "$OLD_VAULT" && ! -L "$OLD_VAULT" && ! -e "$NEW_VAULT_DEFAULT" ]]; then
  mv -- "$OLD_VAULT" "$NEW_VAULT_DEFAULT"
  echo "degsellos-init: flyttade $OLD_VAULT till $NEW_VAULT_DEFAULT"
  obs="${DEGSELLOS_OBSIDIAN_KONFIG:-$HOME/.var/app/md.obsidian.Obsidian/config/obsidian}/obsidian.json"
  if [[ -f "$obs" ]] && grep -Fq "\"path\":\"$OLD_VAULT\"" "$obs"; then
    sed -i "s|\"path\":\"$OLD_VAULT\"|\"path\":\"$NEW_VAULT_DEFAULT\"|" "$obs"
  fi
fi
if [[ -d "$CONFIG_HOME/forskaros" && ! -e "$CONFIG_HOME/degsellos" ]]; then
  mv -- "$CONFIG_HOME/forskaros" "$CONFIG_HOME/degsellos"
fi
migrate_plugin() {
  local vault="$1" old="$1/.obsidian/plugins/forskaros-core" new="$1/.obsidian/plugins/degsellos-core"
  [[ -d "$old" && ! -e "$new" ]] || return 0
  mv -- "$old" "$new"
  local list="$vault/.obsidian/community-plugins.json"
  [[ -f "$list" ]] && sed -i 's/"forskaros-core"/"degsellos-core"/' "$list"
}

# DegsellOS typsnitt även i Flatpak-program (Firefox, LibreOffice, Obsidian, Zotero).
# De läser inte systemets /etc/fonts men väl användarens fontconfig. Filen läggs dit
# en gång; tar forskaren bort den kommer den inte tillbaka.
FONTCONF="${DEGSELLOS_TYPSNITT:-/usr/share/degsellos/identitet/52-degsellos-typsnitt.conf}"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}"
if [[ -f "$FONTCONF" && ! -e "$CONFIG/degsellos/typsnitt.installerade" ]]; then
  mkdir -p "$CONFIG/fontconfig/conf.d" "$CONFIG/degsellos"
  [[ -e "$CONFIG/fontconfig/conf.d/$(basename "$FONTCONF")" ]] || cp -- "$FONTCONF" "$CONFIG/fontconfig/conf.d/"
  : > "$CONFIG/degsellos/typsnitt.installerade"
fi

# Obsidian öppnar forskningsmappen vid första start i stället för att be forskaren
# leta upp den. Görs bara när Obsidian inte har några egna inställningar än.
OBSIDIAN_CONF="${DEGSELLOS_OBSIDIAN_KONFIG:-$HOME/.var/app/md.obsidian.Obsidian/config/obsidian}"
if [[ ! -e "$OBSIDIAN_CONF/obsidian.json" ]]; then
  mkdir -p "$OBSIDIAN_CONF"
  vault_id=$(printf '%s' "$TARGET" | sha256sum | cut -c1-16)
  printf '{"vaults":{"%s":{"path":"%s","ts":%s,"open":true}}}\n' \
    "$vault_id" "$TARGET" "$(date +%s)000" > "$OBSIDIAN_CONF/obsidian.json"
fi

if [[ ! -d "$SEED" ]]; then
  echo "degsellos-init: hittar inte $SEED" >&2
  exit 1
fi

# Delad mapp från värddatorn (virtuell maskin) som genväg i hemkatalogen.
if mountpoint -q /var/mnt/delad 2>/dev/null && [[ ! -e "$HOME/Delad" && ! -L "$HOME/Delad" ]]; then
  ln -s /var/mnt/delad "$HOME/Delad"
fi

[[ -d "$TARGET" ]] && migrate_plugin "$TARGET"

if [[ ! -e "$TARGET" ]]; then
  cp -R -- "$SEED" "$TARGET"
  chmod -R u+rwX -- "$TARGET"
  echo "degsellos-init: skapade $TARGET"
  # Första inloggningen: öppna appen DegsellOS med installationens läge och första steg.
  if [[ -z "${DEGSELLOS_INGEN_VALKOMST:-}" && -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]] && command -v gtk-launch >/dev/null 2>&1; then
    gtk-launch io.github.jtensetti.DegsellOS >/dev/null 2>&1 || true
  fi
  exit 0
fi

# Vaulten finns redan. Uppdatera bara tilläggets egna filer, och bara om
# forskaren inte har tagit bort tillägget.
if [[ -d "$TARGET/$PLUGIN_REL" ]]; then
  for f in main.js manifest.json styles.css; do
    if ! cmp -s "$SEED/$PLUGIN_REL/$f" "$TARGET/$PLUGIN_REL/$f"; then
      cp -- "$SEED/$PLUGIN_REL/$f" "$TARGET/$PLUGIN_REL/$f"
      echo "degsellos-init: uppdaterade $PLUGIN_REL/$f"
    fi
  done
fi

# Systemets egna sidor (verktygskort, Forskarhandboken) hålls uppdaterade.
# Forskaren skriver egna anteckningar någon annanstans; dessa mappar ägs av systemet.
for dir in "00 START/Verktyg" "00 START/Forskarhandboken"; do
  [[ -d "$SEED/$dir" ]] || continue
  mkdir -p "$TARGET/$dir"
  for src in "$SEED/$dir"/*; do
    [[ -f "$src" ]] || continue
    dst="$TARGET/$dir/$(basename "$src")"
    if ! cmp -s "$src" "$dst"; then
      cp -- "$src" "$dst"
      echo "degsellos-init: uppdaterade $dir/$(basename "$src")"
    fi
  done
done
