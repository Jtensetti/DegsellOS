#!/usr/bin/env bash
# Körs vid inloggning (GNOME autostart).
#  1. Skapar ~/ForskarOS från seed-vaulten om den inte finns.
#  2. Uppdaterar ForskarOS Core-tillägget i en befintlig vault när OS:et har
#     uppdaterats. Forskarens egna anteckningar rörs aldrig.
#  3. Ger Flatpak-programmen ForskarOS typsnitt, en gång.
#  4. Låter Obsidian öppna forskningsmappen direkt, om Obsidian inte redan har valv.
set -euo pipefail

SEED=/usr/share/forskaros/vault
TARGET="${FORSKAROS_VAULT:-$HOME/ForskarOS}"
PLUGIN_REL=.obsidian/plugins/forskaros-core

# ForskarOS typsnitt även i Flatpak-program (Firefox, LibreOffice, Obsidian, Zotero).
# De läser inte systemets /etc/fonts men väl användarens fontconfig. Filen läggs dit
# en gång; tar forskaren bort den kommer den inte tillbaka.
FONTCONF="${FORSKAROS_TYPSNITT:-/usr/share/forskaros/identitet/52-forskaros-typsnitt.conf}"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}"
if [[ -f "$FONTCONF" && ! -e "$CONFIG/forskaros/typsnitt.installerade" ]]; then
  mkdir -p "$CONFIG/fontconfig/conf.d" "$CONFIG/forskaros"
  [[ -e "$CONFIG/fontconfig/conf.d/$(basename "$FONTCONF")" ]] || cp -- "$FONTCONF" "$CONFIG/fontconfig/conf.d/"
  : > "$CONFIG/forskaros/typsnitt.installerade"
fi

# Obsidian öppnar forskningsmappen vid första start i stället för att be forskaren
# leta upp den. Görs bara när Obsidian inte har några egna inställningar än.
OBSIDIAN_CONF="${FORSKAROS_OBSIDIAN_KONFIG:-$HOME/.var/app/md.obsidian.Obsidian/config/obsidian}"
if [[ ! -e "$OBSIDIAN_CONF/obsidian.json" ]]; then
  mkdir -p "$OBSIDIAN_CONF"
  vault_id=$(printf '%s' "$TARGET" | sha256sum | cut -c1-16)
  printf '{"vaults":{"%s":{"path":"%s","ts":%s,"open":true}}}\n' \
    "$vault_id" "$TARGET" "$(date +%s)000" > "$OBSIDIAN_CONF/obsidian.json"
fi

if [[ ! -d "$SEED" ]]; then
  echo "forskaros-init: hittar inte $SEED" >&2
  exit 1
fi

# Delad mapp från värddatorn (virtuell maskin) som genväg i hemkatalogen.
if mountpoint -q /var/mnt/delad 2>/dev/null && [[ ! -e "$HOME/Delad" && ! -L "$HOME/Delad" ]]; then
  ln -s /var/mnt/delad "$HOME/Delad"
fi

if [[ ! -e "$TARGET" ]]; then
  cp -R -- "$SEED" "$TARGET"
  chmod -R u+rwX -- "$TARGET"
  echo "forskaros-init: skapade $TARGET"
  # Första inloggningen: öppna appen ForskarOS med installationens läge och första steg.
  if [[ -z "${FORSKAROS_INGEN_VALKOMST:-}" && -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]] && command -v gtk-launch >/dev/null 2>&1; then
    gtk-launch io.github.jtensetti.Forskaros >/dev/null 2>&1 || true
  fi
  exit 0
fi

# Vaulten finns redan. Uppdatera bara tilläggets egna filer, och bara om
# forskaren inte har tagit bort tillägget.
if [[ -d "$TARGET/$PLUGIN_REL" ]]; then
  for f in main.js manifest.json styles.css; do
    if ! cmp -s "$SEED/$PLUGIN_REL/$f" "$TARGET/$PLUGIN_REL/$f"; then
      cp -- "$SEED/$PLUGIN_REL/$f" "$TARGET/$PLUGIN_REL/$f"
      echo "forskaros-init: uppdaterade $PLUGIN_REL/$f"
    fi
  done
fi

# Systemets egna sidor (verktygskort, Forskarhandboken) hålls uppdaterade.
# Forskaren skriver egna anteckningar någon annanstans; dessa mappar ägs av systemet.
for dir in "00 START/Verktyg" "00 START/Forskarhandboken"; do
  [[ -d "$SEED/$dir" ]] || continue
  mkdir -p "$TARGET/$dir"
  for src in "$SEED/$dir"/*; do
    [[ -f "$src" ]] || continue
    dst="$TARGET/$dir/$(basename "$src")"
    if ! cmp -s "$src" "$dst"; then
      cp -- "$src" "$dst"
      echo "forskaros-init: uppdaterade $dir/$(basename "$src")"
    fi
  done
done
